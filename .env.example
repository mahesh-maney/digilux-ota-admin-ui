# ─── Branding ───────────────────────────────────────────────────────────────
# Shown in navbar logo and login page
VITE_LOGO_URL=https://example.com/your-logo.png
VITE_BRAND_NAME=YourCompanyName
VITE_APP_SUBTITLE=OTA Admin

# ─── Navigation labels ───────────────────────────────────────────────────────
VITE_NAV_UPLOAD=Upload
VITE_NAV_PACKAGES=Packages
VITE_NAV_DEPLOYMENTS=Deployments

# ─── Device types (comma-separated, shown in Upload dropdown) ────────────────
# Add or remove types to match the firmware categories your devices use
VITE_DEVICE_TYPES=Firmware_Type_A,Firmware_Type_B

# ─── API & Auth ──────────────────────────────────────────────────────────────
# API Gateway base URL for this customer's deployment
VITE_API_BASE=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/api/v1
# Cognito endpoint — always https://cognito-idp.<region>.amazonaws.com/
VITE_COGNITO_URL=https://cognito-idp.<region>.amazonaws.com/
# Cognito App Client ID for the OTA admin user pool
VITE_COGNITO_CLIENT=<client-id>
